{
  "name": "@averay/codeformat",
  "version": "0.4.7",
  "description": "A very opinionated collection of configurations for a number of code formatting tools.",
  "homepage": "https://github.com/adamaveray/codeformat",
  "license": "MIT",
  "author": "Adam Averay (https://adamaveray.com.au/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamaveray/codeformat.git"
  },
  "bin": {
    "codeformat": "dist/bin/codeformat.js"
  },
  "files": [
    "/.editorconfig",
    "/.swift-format",
    "/autoload.php",
    "/dist",
    "/mago.base.toml",
    "/README.md",
    "/tsconfig.base.json",
    "/types.d.ts"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && vp run --cache build:tsc && vp run build:php && vp exec -c 'chmod +x dist/bin/*.js'",
    "build:tsc": "vp exec tsc --project tsconfig.build.json --outDir dist",
    "build:php": "mkdir -p dist/src dist/rulesets && cp -R src/php dist/src/ && cp rulesets/php-cs-fixer.php dist/rulesets/",
    "test": "vp test",
    "format": "vp run build && vp exec dist/bin/codeformat.js fix",
    "lint": "vp run build && vp exec dist/bin/codeformat.js check",
    "prepack": "vp run build",
    "release": "vp run lint && vp exec bumpp && vp exec pnpm publish --access=public",
    "watch": "vp run build:php && vp run build:tsc --watch"
  },
  "dependencies": {
    "@averay/css-properties-sort-order": "^1.0.3",
    "globals": "^17.14.0",
    "ignore": "^7.0.14",
    "postcss-html": "^2.0.1",
    "postcss-scss": "^4.0.9",
    "postcss-styled-syntax": "^0.7.4",
    "stylelint-config-recommended": "^19.0.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-plugin-defensive-css": "^2.10.0",
    "stylelint-scss": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "dclint": "^3.1.0",
    "knip": "^6.45.1",
    "stylelint": "^18.0.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "dclint": "^3.1.0",
    "knip": "^6.42",
    "stylelint": "^18.0"
  },
  "peerDependenciesMeta": {
    "dclint": {
      "optional": true
    },
    "knip": {
      "optional": true
    }
  },
  "overrides": {
    "dclint": {
      "cosmiconfig": "10.0"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
